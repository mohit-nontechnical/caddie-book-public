# OpenRouter API key — get one at https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-...

# Round storage.
# Local dev: leave these blank — rounds are stored in a local SQLite file (caddie.db).
# Free cloud: create a DB at https://turso.tech and paste the URL + token below.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# Passcode gate — set this in Vercel env vars to lock the app behind a passcode.
# Leave blank (or unset) for local dev to skip the gate entirely.
APP_PASSCODE=
